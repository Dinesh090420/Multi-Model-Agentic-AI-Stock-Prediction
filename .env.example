# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored and must NEVER be committed.
# Note: config.py reads these from the environment. Export them in the
# terminal, e.g.  export NEWSAPI_KEY="your_key"  before running the scripts.

# NewsAPI key for LIVE prediction only (https://newsapi.org). Not needed for
# the historical experiments.
NEWSAPI_KEY=your_newsapi_key_here

# Optional overrides (defaults are in config.py)
HORIZON=1
SIGNAL_BAND=0.005
MODEL_PATH=ProsusAI/finbert
DEVICE=auto
LOG_LEVEL=INFO
